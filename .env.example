# Choose ollama, deepseek, or custom. No university endpoint is required.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Hosted alternative: set LLM_PROVIDER=deepseek and supply your own key.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Generic/legacy OpenAI-compatible endpoint: LLM_PROVIDER=custom
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=dummy
# MODEL_NAME=qwen2.5:3b

# Local prototype authentication; do not expose this app publicly.
CHAINLIT_LOCAL_USERNAME=local
CHAINLIT_LOCAL_PASSWORD=local
CHAINLIT_AUTH_SECRET=local-dev-chainlit-secret-change-me
# DATABASE_PATH=data/chatbot.db
